# Salin file ini ke .env.local lalu isi dengan nilai dari Supabase Dashboard
# Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key (Project Settings > API > service_role). Keep this secret —
# never prefix it with NEXT_PUBLIC_. Required for admin features (Master
# Karyawan account creation, avatar uploads).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
